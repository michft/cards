{
  "buildCommand": "pnpm web:build",
  "outputDirectory": "apps/app/dist",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/offline-manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/game/clock",
      "destination": "/game/[gameId].html"
    },
    {
      "source": "/game/freecell",
      "destination": "/game/[gameId].html"
    },
    {
      "source": "/game/klondike",
      "destination": "/game/[gameId].html"
    },
    {
      "source": "/game/pyramid",
      "destination": "/game/[gameId].html"
    },
    {
      "source": "/game/spider",
      "destination": "/game/[gameId].html"
    },
    {
      "source": "/rules",
      "destination": "/rules.html"
    },
    {
      "source": "/settings",
      "destination": "/settings.html"
    }
  ]
}
